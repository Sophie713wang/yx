                <div class="stat-row"><span class="stat-label">MP</span><div class="bar-bg"><div class="bar-fill" id="mpBar" style="background:var(--p-mp); width:0%;"></div></div><span class="stat-val" id="val-water">0杯</span></div>
                <div class="stat-row"><span class="stat-label">STA</span><div class="bar-bg"><div class="bar-fill" id="staminaBar" style="background:var(--p-stamina); width:0%;"></div></div><span class="stat-val" id="val-steps">--步</span></div>
