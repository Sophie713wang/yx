        }
        function addSop(type) {
            const v = document.getElementById('in-sop-'+type).value;
            if(v) { gameData.sop[type].push({ id: Date.now().toString(), text: v, done: false }); saveGame(); renderSop(type, 'sop-'+type); }
        }
        function delSop(type, idx) {
            if(confirm('删除此任务？')) { gameData.sop[type].splice(idx, 1); saveGame(); renderSop(type, 'sop-'+type); }
        }

        function saveHospitalDate() {
            gameData.hospital.date = document.getElementById('in-hospital-date').value;
            saveGame(); renderHealthPanel(); alert('驻扎日已记录！');
        }

        function moveFun(cat, from, to, idx) {
            const item = gameData.collections[cat][from].splice(idx, 1)[0];
            gameData.collections[cat][to].push(item);
            if(to === 'done') gainReward(20, 15, '战利品入库'); 
            saveGame(); openSubPage('fun');
        }
        function addFun(cat) {
            const v = document.getElementById('in-fun-'+cat).value;
            if(v) { gameData.collections[cat].pending.push({text: v}); saveGame(); openSubPage('fun'); }
        }
        function delFun(cat, state, idx) {
            if(confirm('彻底删除？')) { gameData.collections[cat][state].splice(idx, 1); saveGame(); openSubPage('fun'); }
        }

        function renderShop() {
            const l = document.getElementById('shop-list');
            l.innerHTML = '';
            gameData.shop.forEach((item, idx) => {
                l.innerHTML += `<div class="task-item"><span style="font-size:24px;">${item.icon}</span><span class="task-text" style="margin-left:10px;">${item.name}</span><span style="color:#ff9900; font-weight:bold; margin-right:10px;">${item.price} 🪙</span><button onclick="buyItem(${idx})" style="background:#ffd700; border:2px solid #3e1f5c; padding:2px 10px; cursor:pointer;">兑换</button><span class="del-btn" onclick="delShop(${idx})">✕</span></div>`;
            });
        }
        function buyItem(idx) {
            const item = gameData.shop[idx];
            if(gameData.player.coins < item.price) return alert('金币不足！去完成任务吧！');
            gameData.player.coins -= item.price;
            if(gameData.player.coins >= 1000) unlockBadge('b38');
            if(item.name.includes('奶茶')) unlockBadge('b2');
            alert(`成功兑换：${item.name}！`);
            saveGame(); updateHUD(); openSubPage('shop');
        }
        function addShop() {
            const name = document.getElementById('shop-name').value;
            const price = parseInt(document.getElementById('shop-price').value);
            if(name && price) { gameData.shop.push({ id: Date.now().toString(), name, price, icon: '🎁' }); saveGame(); openSubPage('shop'); }
        }
        function delShop(idx) { gameData.shop.splice(idx, 1); saveGame(); openSubPage('shop'); }

        function saveHealth() {
            const t = document.getElementById('in-temp').value;
            const s = document.getElementById('in-steps').value;
            const w = document.getElementById('in-water').value;
            if(!gameData.health[todayStr]) gameData.health[todayStr] = {};
            gameData.health[todayStr].temp = t;
            gameData.health[todayStr].steps = s;
            gameData.health[todayStr].water = parseInt(w) || 0;
            gainReward(10, 5, '更新属性');
            saveGame(); renderHealthPanel(); closeSubPage();
        }

        function saveNotes() { localStorage.setItem('APL_Notes', document.getElementById('diary-text').value); alert('已保存！'); }
        function exportData() { navigator.clipboard.writeText(JSON.stringify(gameData)).then(() => alert('数据已复制！')); }
        function importData() {
            const str = prompt('请粘贴导出的数据：');
            if(str) { try { gameData = JSON.parse(str); saveGame(); location.reload(); } catch(e) { alert('格式错误。'); } }
        }
        function resetGame() { if(confirm('确定清档吗？')) { localStorage.removeItem('APL_Pixel_v7'); location.reload(); } }

        window.onload = init;
    </script>
</body>
</html>
`;

