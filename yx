    </div>

    <script>
        const generateBadges = () => {
            const list = [];
            const icons = ['🔥','🛡️','🧋','🏃','👑','🌙','⚔️','💎','🎯','🍀','🌟','💖','🍰','📚','🎮','🎬','🎧','📻','💧','☀️','🌧️','⛄','🍎','🍔','💊','🏥','💉','🩸','🧬','🧪','🩺','🏆','🎖️','🥇','🥈','🥉','🎗️','💮','㊗️','🈵','💯','💢'];
            const names = ['初来乍到','签到七日','半月坚守','满月战士','季度达人','半年坚守','全年无休','Lv.5 达人','Lv.10 传奇','满级大佬','首通诱导','腰穿通关','巩固循环1','巩固循环2','巩固循环3','巩固循环4','维持期开启','稳住别浪','健康卫士','属性拉满','第一杯奶茶','大餐一顿','烧烤自由','咖啡续命','喝水狂魔','步数过万','早睡冠军','按时吃药','战利品+1','战利品+5','战利品+10','影视达人','读书破万','游戏通关','广播剧迷','播客常客','金币破百','金币破千','一掷千金','连续签到30天','连续签到100天','终极探索者'];
            for(let i=0; i<42; i++) {
                list.push({ id: 'b' + i, name: names[i], icon: icons[i], unlocked: false });
            }
            return list;
        };

        let gameData = {
            player: { level: 1, exp: 0, coins: 100, title: 'NEWBIE', checkinStreak: 0, lastCheckinDate: '' },
            todo: [{ id: 't1', text: '买护手霜', done: false }],
            sop: { 
                daily: [{ id: 'd1', text: '早睡 23:00', done: false }, { id: 'd2', text: '按时吃药', done: false }],
                weekly: [{ id: 'w1', text: '大扫除', done: false }],
                monthly: [{ id: 'm1', text: '整理照片', done: false }],
                yearly: [{ id: 'y1', text: '全面体检', done: false }]
            },
            cycles: { daily: '', weekly: '', monthly: '', yearly: '' },
            health: {}, 
            hospital: { date: '' }, 
            collections: { 
                games: { pending: [{text:'塞尔达'}], done: [] }, 
                movies: { pending: [{text:'奥本海默'}], done: [] }, 
                books: { pending: [], done: [] },
                dramas: { pending: [{text:'某某广播剧'}], done: [] },
                podcasts: { pending: [{text:'随机波动'}], done: [] }
            },
            shop: [{ id: 's1', name: '喝一杯奶茶', price: 50, icon: '🧋' }],
            badges: generateBadges(),
            activities: [],
            lastTodoDate: '' 
        };

        const today = new Date();
        const todayStr = today.toISOString().split('T')[0];
        const getWeekStr = (d) => { 
            const target = new Date(d.valueOf()); 
            const dayNr = (d.getDay() + 6) % 7; 
            target.setDate(target.getDate() - dayNr + 3); 
            const firstThursday = target.valueOf(); 
            target.setMonth(0, 1); 
            if (target.getDay() !== 4) { target.setMonth(0, 1 + ((4 - target.getDay() + 7) % 7)); } 
            return d.getFullYear() + '-' + (1 + Math.ceil((firstThursday - target) / 604800000)); 
        };
        const todayWeek = getWeekStr(today);
        const todayMonth = today.getFullYear() + '-' + (today.getMonth() + 1);
        const todayYear = today.getFullYear().toString();

        function init() {
            const saved = localStorage.getItem('APL_Pixel_v7');
            if (saved) {
                gameData = JSON.parse(saved);
                if(!gameData.badges || gameData.badges.length < 42) gameData.badges = generateBadges();
            }
            checkCycles(); 
            checkTodoPenalty(); 
            updateHUD();
            renderCheckin();
            renderActivities();
            renderHealthPanel();
            fetchWeather();
        }

        function saveGame() { localStorage.setItem('APL_Pixel_v7', JSON.stringify(gameData)); }

        function checkCycles() {
            let changed = false;
            if (gameData.cycles.daily !== todayStr) { gameData.sop.daily.forEach(i => i.done = false); gameData.cycles.daily = todayStr; changed = true; }
            if (gameData.cycles.weekly !== todayWeek) { gameData.sop.weekly.forEach(i => i.done = false); gameData.cycles.weekly = todayWeek; changed = true; }
            if (gameData.cycles.monthly !== todayMonth) { gameData.sop.monthly.forEach(i => i.done = false); gameData.cycles.monthly = todayMonth; changed = true; }
            if (gameData.cycles.yearly !== todayYear) { gameData.sop.yearly.forEach(i => i.done = false); gameData.cycles.yearly = todayYear; changed = true; }
            if (changed) saveGame();
        }

        // --- 惩罚机制：没做完 Todo 扣 50 金币 ---
        function checkTodoPenalty() {
            if (gameData.lastTodoDate !== todayStr) {
                const hasUnfinished = gameData.todo.some(t => !t.done);
                if (hasUnfinished && gameData.lastTodoDate !== '') {
                    gameData.player.coins = Math.max(0, gameData.player.coins - 50); // 扣除 50 金币
                    addActivity('⚠️ 惩罚：昨日 TodoList 未完成，扣除 50 金币！');
                    setTimeout(() => alert('⚠️ 警告：因昨日未完成 Todo，扣除 50 金币！去补给站买不了东西了哦！'), 500);
                }
                gameData.todo.forEach(t => t.done = false);
                gameData.lastTodoDate = todayStr;
                saveGame();
            }
        }

        function gainReward(exp, coin, reason) {
            gameData.player.exp += exp;
            gameData.player.coins += coin;
            showFloat(`+${exp} EXP`, '#ffd700');
            if(coin > 0) showFloat(`+${coin} 🪙`, '#ff9900', 60);
            
            if(gameData.player.exp >= gameData.player.level * 100) {
                gameData.player.exp -= gameData.player.level * 100;
                gameData.player.level++;
                setTimeout(() => alert('LEVEL UP! 等级提升！获得50金币！'), 300);
                gameData.player.coins += 50;
                if(gameData.player.level >= 5) unlockBadge('b7');
                if(gameData.player.level >= 10) unlockBadge('b8');
            }
            if (gameData.player.level >= 10) gameData.player.title = 'LEGEND';
            else if (gameData.player.level >= 5) gameData.player.title = 'GUARDIAN';
            else if (gameData.player.level >= 3) gameData.player.title = 'EXPLORER';
            
            if(reason.includes('早睡')) unlockBadge('b6');
            addActivity(`完成[${reason}]，获得奖励。`);
            saveGame(); updateHUD();
        }

        function showFloat(text, color, offset = 0) {
            const el = document.createElement('div');
            el.className = 'floating-text';
            el.innerText = text;
            el.style.color = color;
            el.style.left = `calc(50% + ${offset}px)`;
            el.style.top = '40%';
            document.body.appendChild(el);
            setTimeout(() => el.remove(), 1000);
        }

        function updateHUD() {
            document.getElementById('playerTitle').innerText = gameData.player.title;
            document.getElementById('playerLevel').innerText = gameData.player.level;
            document.getElementById('coinCount').innerText = gameData.player.coins;
            const p = Math.min((gameData.player.exp / (gameData.player.level * 100)) * 100, 100);
            document.getElementById('expFill').style.width = `${p}%`;
        }

        function renderCheckin() {
            const grid = document.getElementById('checkinGrid');
            grid.innerHTML = '';
            const streak = gameData.player.checkinStreak % 8;
            for (let i = 1; i <= 7; i++) {
                const checked = (gameData.player.lastCheckinDate === todayStr && streak >= i) || (gameData.player.lastCheckinDate !== todayStr && streak >= i);
                grid.innerHTML += `<div class="checkin-day ${checked ? 'checked' : ''}">${checked ? '🎁' : i}</div>`;
            }
            const btn = document.getElementById('checkinBtnContainer');
            if (gameData.player.lastCheckinDate !== todayStr) {
                btn.innerHTML = `<button onclick="doCheckin()" style="width:100%; padding:8px; font-family:'VT323'; font-size:20px; background:#e0548f; color:#fff; border:2px solid #3e1f5c; cursor:pointer;">📥 领取今日签到</button>`;
            } else {
                btn.innerHTML = `<div style="color:#7b2cbf; font-size:16px;">✅ 今日已签到 (连续 ${gameData.player.checkinStreak} 天)</div>`;
            }
        }

        function doCheckin() {
            gameData.player.lastCheckinDate = todayStr;
            gameData.player.checkinStreak++;
            let rewardCoin = 20;
            if(gameData.player.checkinStreak % 7 === 0) rewardCoin = 100;
            gainReward(20, rewardCoin, '每日签到');
            if(gameData.player.checkinStreak >= 7) unlockBadge('b1');
            if(gameData.player.checkinStreak >= 30) unlockBadge('b39');
            if(gameData.player.checkinStreak >= 100) unlockBadge('b40');
            renderCheckin();
        }

        function addActivity(text) {
            const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            gameData.activities.unshift({ text, time });
            if (gameData.activities.length > 4) gameData.activities.pop();
            renderActivities();
        }
        function renderActivities() {
            const c = document.getElementById('recent-activity');
            c.innerHTML = gameData.activities.length === 0 ? '<div style="color:#888;">暂无记录...</div>' : '';
            gameData.activities.forEach(a => {
                c.innerHTML += `<div style="border-bottom:1px dashed #b892cf; padding:4px 0;">[${a.time}] ${a.text}</div>`;
            });
        }

        function renderHealthPanel() {
