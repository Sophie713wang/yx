        // --- 绘图函数 (像素风) ---
        function setupCanvas(id) {
            const canvas = document.getElementById(id);
            if(!canvas) return null;
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
            return { canvas, ctx };
        }

        function drawLineChart() {
            const setup = setupCanvas('lineChart');
            if(!setup) return;
            const { canvas, ctx } = setup;
            const w = canvas.width, h = canvas.height;
            const pad = 20;
            
            // 获取近7天体温
            let temps = [];
            for(let i=6; i>=0; i--) {
                const d = new Date(); d.setDate(d.getDate() - i);
                const dStr = d.toISOString().split('T')[0];
                const hData = gameData.health[dStr];
                temps.push(hData && hData.temp ? parseFloat(hData.temp) : 36.5);
            }
            
            ctx.strokeStyle = '#b892cf'; ctx.lineWidth = 1;
            for(let i=0; i<=4; i++) { ctx.beginPath(); ctx.moveTo(pad, pad + (h-pad*2)*(i/4)); ctx.lineTo(w-pad, pad + (h-pad*2)*(i/4)); ctx.stroke(); }
            
            ctx.beginPath(); ctx.strokeStyle = '#ff4d88'; ctx.lineWidth = 3;
            temps.forEach((val, i) => {
                // 把 36-40 度映射到高度
                let percent = (val - 35) / 5; 
                if(percent < 0) percent = 0; if(percent > 1) percent = 1;
                const x = pad + (w - pad*2) * (i / 6);
                const y = h - pad - (percent * (h - pad*2));
                if(i===0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
            });
            ctx.stroke();
            
            // 画点
            temps.forEach((val, i) => {
                let percent = (val - 35) / 5; 
                if(percent < 0) percent = 0; if(percent > 1) percent = 1;
                const x = pad + (w - pad*2) * (i / 6);
                const y = h - pad - (percent * (h - pad*2));
                ctx.beginPath(); ctx.fillStyle = '#ff4d88'; ctx.fillRect(x-3, y-3, 6, 6);
            });
        }

        function drawBarChart() {
            const setup = setupCanvas('barChart');
            if(!setup) return;
            const { canvas, ctx } = setup;
            const w = canvas.width, h = canvas.height;
            
            let steps = [];
            for(let i=6; i>=0; i--) {
                const d = new Date(); d.setDate(d.getDate() - i);
                const dStr = d.toISOString().split('T')[0];
                const hData = gameData.health[dStr];
                steps.push(hData && hData.steps ? parseInt(hData.steps) : 0);
            }
            const max = Math.max(...steps, 5000);
            const barW = (w - 40) / 7;
            
            steps.forEach((val, i) => {
                const barH = (val / max) * (h - 40);
                const x = 20 + i * barW + 5;
                const y = h - 20 - barH;
                ctx.fillStyle = '#4db8ff';
                ctx.fillRect(x, y, barW - 10, barH);
                ctx.strokeStyle = '#3e1f5c'; ctx.lineWidth = 2;
                ctx.strokeRect(x, y, barW - 10, barH);
            });
        }

        function drawPieChart() {
            const setup = setupCanvas('pieChart');
            if(!setup) return;
            const { canvas, ctx } = setup;
            const cx = canvas.width/2, cy = canvas.height/2, r = Math.min(cx, cy)-10;
            
            const games = gameData.collections.games.done.length;
            const movies = gameData.collections.movies.done.length;
            const books = gameData.collections.books.done.length;
            const dramas = gameData.collections.dramas.done.length;
            const podcasts = gameData.collections.podcasts.done.length;
            
            const data = [games, movies, books, dramas, podcasts];
            const total = data.reduce((a,b)=>a+b, 0);
            const colors = ['#ff4d88', '#4db8ff', '#ffd700', '#b892cf', '#4dffb8'];
            
            if(total === 0) {
                ctx.fillStyle = '#ddd'; ctx.beginPath(); ctx.arc(cx,cy,r,0,Math.PI*2); ctx.fill();
                ctx.fillStyle = '#888'; ctx.font = '16px VT323'; ctx.textAlign = 'center'; ctx.fillText('暂无数据', cx, cy);
                return;
            }
            
            let start = -Math.PI/2;
            data.forEach((val, i) => {
                if(val === 0) return;
                const angle = (val/total) * Math.PI*2;
                ctx.beginPath(); ctx.moveTo(cx,cy); ctx.arc(cx,cy,r,start,start+angle); ctx.fillStyle = colors[i]; ctx.fill();
                start += angle;
            });
            ctx.beginPath(); ctx.arc(cx,cy,r*0.5,0,Math.PI*2); ctx.fillStyle = '#faeef5'; ctx.fill();
            ctx.strokeStyle = '#3e1f5c'; ctx.lineWidth = 4; ctx.stroke();
        }

