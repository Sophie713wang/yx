        .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; text-align: center; }
        .cal-cell { padding: 8px 0; border: 1px solid #b892cf; background: #fff; cursor: pointer; font-size: 16px; }
        .cal-cell.has-data { background: var(--p-accent); color: #fff; font-weight: bold; border-color: var(--p-border-outer); }
        
        /* 图表容器 */
        .chart-box { width: 100%; height: 160px; background: #fff; border: 2px solid var(--p-border-outer); margin-top: 10px; }
        canvas { width: 100%; height: 100%; image-rendering: pixelated; }
    </style>
